<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- No com.apple.security.network.client: this build has no account and opens no connection. See docs/CHANNELS.md. -->
  <!-- Open/New database, pick an import CSV, delete that CSV after import. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Remember the chosen database across launches (not wired up yet: see docs/CHANNELS.md). -->
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <key>com.apple.developer.authentication-services.autofill-credential-provider</key>
  <true/>
  <!-- The bridge socket to the browser extensions lives in the shared group container. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>2S468LUF8V.com.oldcai.passwordpie</string>
  </array>
</dict>
</plist>
