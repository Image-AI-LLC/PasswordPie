{
  "name": "passwordpie-extension",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "typecheck": "wxt prepare && tsc --noEmit",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip:chrome-store": "PP_STORE_PACKAGE=1 wxt zip -b chrome --mv3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^31.0.0",
    "qrcode": "1.5.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "0.20.27"
  },
  "dependencies": {
    "jsqr": "1.4.0"
  }
}
